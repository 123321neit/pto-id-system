{
  "name": "@pto/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:check": "tsx src/infrastructure/database/db-check.cli.ts",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint .",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.19.3",
    "@pto/shared-config": "workspace:*",
    "@pto/shared-types": "workspace:*",
    "bullmq": "^5.0.0",
    "dotenv-flow": "^4.1.0",
    "ioredis": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
