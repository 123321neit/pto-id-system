{
  "name": "pto-id-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "corepack pnpm -r build",
    "ci:check": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build",
    "dev": "corepack pnpm --parallel -r dev",
    "format": "prettier --write \"*.{json,md,mjs,yaml,yml}\" \"apps/**/*.{ts,tsx,js,mjs,json,css,html}\" \"packages/**/*.{ts,tsx,js,mjs,json}\"",
    "format:check": "prettier --check \"*.{json,md,mjs,yaml,yml}\" \"apps/**/*.{ts,tsx,js,mjs,json,css,html}\" \"packages/**/*.{ts,tsx,js,mjs,json}\"",
    "lint": "eslint .",
    "test": "corepack pnpm -r test",
    "typecheck": "corepack pnpm --filter @pto/shared-types build && corepack pnpm --filter @pto/shared-config build && corepack pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^16.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.0"
  }
}
